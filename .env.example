# Copy to .env and fill in real values. Never commit .env.
BOT_TOKEN=
ADMIN_CHAT_ID=-1000
WORK_START=09:00
WORK_END=21:00
TIMEZONE=Europe/Moscow

# Optional telethon user client
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_STRING=
OWNER_SESSION=

# Optional proxy, e.g. socks5://127.0.0.1:10808
# Not required: if unset or unreachable the bot connects directly.
TELEGRAM_PROXY=